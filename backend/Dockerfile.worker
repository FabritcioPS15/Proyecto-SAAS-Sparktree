# Dockerfile.worker for Sparktree SaaS Background Workers
FROM node:22-alpine

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Create auth state directory
RUN mkdir -p /tmp/auth_state && chmod 777 /tmp/auth_state

ENV AUTH_STATE_PATH=/tmp/auth_state

# Start worker
CMD ["npm", "run", "worker:automation"]